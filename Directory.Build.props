<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ResourceManager.App' or '$(MSBuildProjectName)' == 'ResourceManager.NativeUi'">
    <!-- Windows NLS retains named cultures and OS language selection without loading .NET's ICU data.
         Restore ICU with -p:ResourceManagerUseNls=false; invariant mode is a separate explicit opt-in. -->
    <ResourceManagerUseNls Condition="'$(ResourceManagerUseNls)' == ''">true</ResourceManagerUseNls>
    <InvariantGlobalization Condition="'$(InvariantGlobalization)' == ''">false</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup>
    <!-- This custom property must be known while native artifact paths are evaluated. -->
    <ResourceManagerStateNames Condition="'$(ResourceManagerStateNames)' == ''">true</ResourceManagerStateNames>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Parallel jobs of the zig builds nested in MSBuild (NativeCore, shared memory adapter). 1 keeps a nested build
         inside the memory ceiling of test and worker runs; pass -p:ResourceManagerZigJobs=N to change it. -->
    <ResourceManagerZigJobs Condition="'$(ResourceManagerZigJobs)' == ''">1</ResourceManagerZigJobs>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Explicit MSBuild ownership also takes precedence over a shared NUGET_PACKAGES environment. -->
    <RestorePackagesPath Condition="'$(RestorePackagesPath)' == ''">$(MSBuildThisFileDirectory)sdk/freedom-point/restored-packages</RestorePackagesPath>
  </PropertyGroup>
</Project>
