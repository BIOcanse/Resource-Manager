* text=auto

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.cs text
*.c text
*.js text
*.css text
*.html text
*.md text
*.json text
*.xml text
src/Shared/StateItems/state-items.json text eol=lf

/tools/catalog-validation/software-metadata/Inputs/*.json text eol=lf
/tools/catalog-validation/software-metadata/Generated/*.json text eol=lf
/src/Core/Infrastructure/Resources/SoftwareMetadata/*.json text eol=lf
/src/UI/Frontend/index.html text eol=lf
/src/UI/Core/Overlay/metric-labels.json text eol=lf

# SDK payloads and their manifests/notices are verified as delivered bytes.
# Text normalization would invalidate provider hashes, including mixed line endings.
/artifacts/sdk/** -text
/artifacts/disk-sdk/** -text
/sdk/freedom-point/** -text
