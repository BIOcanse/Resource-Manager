<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RoslynRoot>$(MSBuildSDKsPath)/../Roslyn/bincore</RoslynRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Development/RuntimeReadCheck/ResourceManager.RuntimeReadCheck.csproj" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(RoslynRoot)/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(RoslynRoot)/Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>
</Project>
