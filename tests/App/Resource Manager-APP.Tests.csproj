  <ItemGroup>
    <None Include="$(GpuLaunchTargetProbePath)"
          Link="GpuLaunchBrokerProbe\ResourceManager.GpuLaunchTargetProbe.exe"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

<Target Name="CopySessionAgent" AfterTargets="Build">
  <MSBuild Projects="$(MSBuildProjectDirectory)\..\..\src\SessionAgent\ResourceManager.SessionAgent.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
    <Output TaskParameter="TargetOutputs" ItemName="SessionAgentTarget" />
  </MSBuild>
  <PropertyGroup><SessionAgentOutputDirectory>@(SessionAgentTarget->'%(RootDir)%(Directory)')</SessionAgentOutputDirectory></PropertyGroup>
  <ItemGroup><SessionAgentFile Include="$(SessionAgentOutputDirectory)*" /></ItemGroup>
  <Copy SourceFiles="@(SessionAgentFile)" DestinationFolder="$(TargetDir)ResourceManagerSessionAgent" />
</Target>
<Target Name="CopyFanControlCoreProbe" AfterTargets="Build">
  <MSBuild Projects="$(MSBuildProjectDirectory)\..\FanControlCoreProbe\FanControlCoreProbe.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
    <Output TaskParameter="TargetOutputs" ItemName="FanControlCoreProbeTarget" />
  </MSBuild>
  <PropertyGroup><FanControlCoreProbeOutputDirectory>@(FanControlCoreProbeTarget->'%(RootDir)%(Directory)')</FanControlCoreProbeOutputDirectory></PropertyGroup>
  <ItemGroup><FanControlCoreProbeFile Include="$(FanControlCoreProbeOutputDirectory)*" /></ItemGroup>
  <Copy SourceFiles="@(FanControlCoreProbeFile)" DestinationFolder="$(TargetDir)FanControlCoreProbe" />
</Target>
<Target Name="CopyHardwareBridgeProcessFixture" AfterTargets="Build">
  <MSBuild Projects="$(MSBuildProjectDirectory)/../Fixtures/HardwareBridgeProcessFixture/HardwareBridgeProcessFixture.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
    <Output TaskParameter="TargetOutputs" ItemName="HardwareBridgeFixtureTarget" />
  </MSBuild>
  <PropertyGroup><HardwareBridgeFixtureDirectory>@(HardwareBridgeFixtureTarget->'%(RootDir)%(Directory)')</HardwareBridgeFixtureDirectory></PropertyGroup>
  <ItemGroup><HardwareBridgeFixtureFile Include="$(HardwareBridgeFixtureDirectory)*" /></ItemGroup>
  <Copy SourceFiles="@(HardwareBridgeFixtureFile)" DestinationFolder="$(TargetDir)HardwareBridgeProcessFixture" />
</Target>
</Project>
