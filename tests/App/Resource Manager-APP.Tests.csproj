    <EmbeddedResource Include="Fixtures\Control\control-instances.installed-c15.json" />
    <EmbeddedResource Include="Fixtures\Optimization\rollback-state.c16-v2.json" />
    <EmbeddedResource Include="Fixtures\Optimization\smart-status.json" LogicalName="smart-status" />
