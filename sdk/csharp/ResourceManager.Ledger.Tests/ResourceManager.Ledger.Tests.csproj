<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants Condition="'$(LedgerInstrumentedConsumer)' == 'true'">$(DefineConstants);LEDGER_DEVELOPMENT_LEASE_ANALYSIS</DefineConstants>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <Import Project="$(LedgerBuildPropsPath)" Condition="'$(LedgerBuildPropsPath)' != ''" />
  <ItemGroup>
    <ProjectReference Include="../ResourceManager.Ledger/ResourceManager.Ledger.csproj" />
    <ProjectReference Include="../ResourceManager.Ledger.Analyzers/ResourceManager.Ledger.Analyzers.csproj" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" Private="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" Private="true" />
  </ItemGroup>
</Project>
