<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <FreedomPointSdkVersion>0.1.0-dev.39</FreedomPointSdkVersion>
    <RestoreSources Condition="'$(RestoreSources)' == ''">$(MSBuildThisFileDirectory)../../../sdk/freedom-point/packages</RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FreedomPoint.Core" Version="$(FreedomPointSdkVersion)" />
    <PackageReference Include="FreedomPoint.Generators" Version="$(FreedomPointSdkVersion)" />
  </ItemGroup>
</Project>
