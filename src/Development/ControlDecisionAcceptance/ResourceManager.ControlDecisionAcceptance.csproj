<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ResourceManager.ControlDecisionAcceptance</AssemblyName>
    <RootNamespace>ResourceManager.ControlDecisionAcceptance</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(ResourceManagerStateNames)' == 'true'">$(DefineConstants);RM_STATE_NAMES</DefineConstants>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../Core/ResourceManager.App.csproj" /></ItemGroup>
  <Target Name="RequireDevelopmentStateNames" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ResourceManagerStateNames)' != 'true'" Text="ControlDecisionAcceptance is development-only and requires ResourceManagerStateNames=true." />
  </Target>
</Project>

