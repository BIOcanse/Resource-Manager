{
  "namespace": "resource-manager",
  "children": [
    {
      "id": "backend",
      "description": "Backend-owned decisions. Current migration covers CPU remediation and its existing scheduling/history consumers, not every backend setting.",
      "children": [
        {
          "id": "monitoring",
          "description": "Backend subscriptions publish current values; readers do not sample.",
          "build": {
            "simple": [
              {
                "index": 0,
                "id": "single_request_stop_buffer_ms",
                "description": "Shared subscription-source stop buffer after a single request ends. Zero disables the buffer; keeping a source in use never schedules sampling.",
                "value_type": "nonnegative_int32",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": 10000,
                "consumers": ["SubscriptionSourceSettings.CompileStopBuffer"]
              }
            ],
            "complex": [
              {
                "value_source": "registry",
                "index": 0,
                "consumers": [
                  "HostManagerPlanCompiler.CompileKernelLeak"
                ],
                "description": "Backend-lifetime named observation demand; enabled controls continuous low-rate sampling, bounded rings and sustained-growth thresholds. Report readers never control observation. reported_item_capacity defaults to 4096, accepts 1-16384 active and history items, and never evicts; users can clear history to free capacity.",
                "id": "kernel_leak_observation",
                "value_type": "object",
                "value": {
                  "minimum_samples": 8,
                  "series_capacity": 32,
                  "handle_floor": 1024,
                  "interval_milliseconds": 30000,
                  "minimum_observation_seconds": 600,
                  "maximum_holders": 4096,
                  "reported_item_capacity": 4096,
                  "minimum_growth": 128,
                  "edge_percentage": 25,
                  "enabled": true
                },
                "status": "active",
                "update_class": "rebuild_backend"
              },
              {
                "value_source": "registry",
                "index": 1,
                "consumers": [
                  "HostManagerPlanCompiler.CompileNotifications"
                ],
                "description": "Backend notification owner. retained_count defaults to 64 and accepts 1-1024 notifications; a new notification beyond it evicts the oldest. Notifications only deliver; the event itself stays in its report or page.",
                "id": "notifications",
                "value_type": "object",
                "value": {
                  "retained_count": 64
                },
                "status": "active",
                "update_class": "rebuild_backend"
              },
              {
                "value_source": "registry",
                "index": 2,
                "consumers": [
                  "HostManagerPlanCompiler.CompileHostMemoryProtectionRecords"
                ],
                "description": "Host memory protection action records. record_capacity defaults to 4096 and accepts 1-16384 records; a full report never evicts, counts what it could not record, and clearing history frees capacity.",
                "id": "memory_protection",
                "value_type": "object",
                "value": {
                  "record_capacity": 4096
                },
                "status": "active",
                "update_class": "rebuild_backend"
              }
            ]
          },
          "children": [
            {
              "id": "cpu_residency",
              "description": "Per-process CPU core observations, distinct from a weighted CPU score.",
              "build": {
                "simple": [
                  {
                    "index": 0,
                    "id": "observation_window_ms",
                    "description": "CPU residency observation window, not algorithm history retention.",
                    "value_type": "positive_int32",
                    "update_class": "rebuild_backend",
                    "status": "active",
                    "value_source": "registry",
                    "value": 5000,
                    "consumers": [
                      "HostManagerPlanCompiler.CompileCpuCoreResidency"
                    ]
                  }
                ],
                "complex": [
                  {
                    "index": 0,
                    "id": "execution_time_source",
                    "description": "Actual per-logical-processor execution durations, not context-switch counts.",
                    "value_type": "object",
                    "update_class": "rebuild_backend",
                    "status": "active",
                    "value_source": "registry",
                    "value": {
                      "kind": "kernel_etw_context_switch_qpc_closed_intervals_v1",
                      "maximum_active_pairs": 65536,
                        "bucket_width_ms": 50
                    },
                    "consumers": [
                      "HostManagerPlanCompiler.CompileCpuCoreResidency"
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "scheduling",
          "description": "Scheduling reads shared snapshots and requests persistent backend subscriptions.",
          "build": {
            "simple": [
              {
                "index": 0,
                "id": "subscription_interval_ms",
                "description": "Scheduler background subscription interval. The current explicit choice is 0.2 Hz. Rebuilding and restarting changes the startup subscriptions.",
                "value_type": "positive_int32",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": 5000,
                "consumers": ["HostManagerPlanCompiler.CompileSchedulerSamplingInterval"]
              }
            ]
          },
          "children": [
            {
              "id": "transitions",
              "description": "Transition decisions, game startup grace and failure retry are independent quantities.",
              "runtime": {
                "simple": [
                  {
                    "index": 0,
                    "id": "required_consecutive_decisions",
                    "description": "Existing confirmation votes. This is not a CPU history length or a score average.",
                    "value_type": "positive_int32",
                    "update_class": "publish_plan",
                    "status": "active",
                    "value_source": "host_manager_profile",
                    "source_path": "/hot_publish/smart_coordinator/required_consecutive_decisions",
                    "consumers": ["HostManagerPlanCompiler.CompileSmartCoordinatorHotPublish"]
                  },
                  {
                    "index": 1,
                    "id": "game_start_grace_ms",
                    "description": "Existing game-start grace. It does not implement lower boost exit thresholds.",
                    "value_type": "positive_int32",
                    "update_class": "publish_plan",
                    "status": "active",
                    "value_source": "host_manager_profile",
                    "source_path": "/hot_publish/smart_coordinator/game_start_grace_ms",
                    "consumers": ["HostManagerPlanCompiler.CompileSmartCoordinatorHotPublish"]
                  },
                  {
                    "index": 2,
                    "id": "failure_retry_ms",
                    "description": "Retry delay following a failed action, not a cooldown following success.",
                    "value_type": "positive_int32",
                    "update_class": "publish_plan",
                    "status": "active",
                    "value_source": "host_manager_profile",
                    "source_path": "/hot_publish/smart_coordinator/failure_retry_ms",
                    "consumers": ["HostManagerPlanCompiler.CompileSmartCoordinatorHotPublish"]
                  }
                ],
                "complex": [
                  {
                    "index": 0,
                    "id": "boost_entry_exit_policy",
                    "description": "Explicit entry and lower exit thresholds for game enhancement.",
                    "value_type": "object",
                    "update_class": "publish_plan",
                    "status": "pending",
                    "pending_reason": "Separate entry/exit quantities and calibration follow the corrected unique CPU score; consecutive votes alone do not implement this policy."
                  },
                  {
                    "index": 1,
                    "id": "game_boost_notification",
                    "description": "Game system notifications: confirmed enhancement and an independently switchable reminder when a running game has not entered enhancement within its configured observation time.",
                    "value_type": "object",
                    "update_class": "publish_plan",
                    "status": "pending",
                    "pending_reason": "NativeUi delivery, persisted switches and named observation duration are not wired to existing game/effect facts yet. Reminders do not retune B, force enhancement or add frontend warnings."
                  }
                ]
              }
            },
            {
              "id": "placement",
              "description": "Placement is not the CPU score denominator.",
              "build": {
                "simple": [
                  {
                    "index": 0,
                    "id": "gpu_api_observation_window_ms",
                    "description": "First-use actual GPU API observation window inside the original placement action deadline; no separate discovery cycle or retry.",
                    "value_type": "positive_int32",
                    "update_class": "rebuild_backend",
                    "status": "active",
                    "value_source": "registry",
                    "value": 5000,
                    "consumers": ["HostManagerPlanCompiler.CompilePlacementCoordinatorHotPublish"]
                  },
                  {
                    "index": 1,
                    "id": "gpu_no_present_expiry_seconds",
                    "description": "Persistent per-image empty Present observation expires after 86400 seconds by default; retry requires a subsequent inventory or GPU-use fact. PID replacement and observer restart do not reset it.",
                    "value_type": "positive_int32",
                    "update_class": "rebuild_backend",
                    "status": "active",
                    "value_source": "registry",
                    "value": 86400,
                    "consumers": ["HostManagerPlanCompiler.CompilePlacementCoordinatorHotPublish"]
                  }
                ],
                "complex": [
                  {
                    "index": 0,
                    "id": "gpu_window_execution_limits",
                    "description": "Serial GPU preparation and controlled window execution: explicit window count, shared cleanup allowance, separate preparation/window payload bounds and pipe buffers. All work shares the original action deadline; no retries or synchronous fallback.",
                    "value_type": "object",
                    "update_class": "rebuild_backend",
                    "status": "active",
                    "value_source": "registry",
                    "value": { "maximum_window_count": 16, "cleanup_reserve_ms": 1000, "maximum_frame_bytes": 80, "pipe_buffer_bytes": 4096, "preparation_maximum_frame_bytes": 590312 },
                    "consumers": ["HostManagerPlanCompiler.CompilePlacementCoordinatorHotPublish"]
                  }
                ]
              },
              "runtime": {
                "simple": [
                  {
                    "index": 0,
                    "id": "action_timeout_ms",
                    "description": "Existing placement action total deadline, shared by policy and serial GPU window work, including cleanup. Not a fresh timeout per window.",
                    "value_type": "positive_int32",
                    "update_class": "publish_plan",
                    "status": "active",
                    "value_source": "host_manager_profile",
                    "source_path": "/hot_publish/placement_coordinator/action_timeout_ms",
                    "consumers": ["HostManagerPlanCompiler.CompilePlacementCoordinatorHotPublish"]
                  }
                ],
                "complex": [
                  {
                    "index": 0,
                    "id": "automatic_exclusivity",
                    "description": "Native placement-session game core/CCD occupancy hysteresis and software reservations. Other software avoids the reservation; the owner is not locked. CPU effects use the existing reversible placement transaction.",
                    "value_type": "object",
                    "update_class": "publish_plan",
                    "status": "active",
                    "value_source": "registry",
                    "value": { "enabled": true, "core_enter_percent": 75, "core_exit_percent": 20, "ccd_enter_percent": 60, "ccd_exit_percent": 30, "qualification_completed_rounds": 3 },
                    "consumers": ["HostManagerPlanCompiler.CompilePlacementCoordinatorHotPublish"]
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "scoring",
          "description": "One software-scoring definition; CPU and GPU remain separate resource dimensions.",
          "build": {
            "complex": [
              {
                "index": 0,
                "id": "software_welfare",
                "description": "The sole native scorer uses its own base_score (0 to maximum base importance, default 100). CPU and memory each add base_score times their direct free-capacity ratio once per software, without recipient counts, state modifiers or CPU capacity compensation. GPU share retains base_score times the product of four free ratios divided by eligible process count.",
                "value_type": "object",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": { "kind": "free_capacity_welfare_bonus", "base_score": 100 },
                "consumers": ["HostManagerPlanCompiler.CompileSmartCoordinatorHotPublish"]
              }
            ]
          },
          "runtime": {
            "complex": [
              {
                "index": 0,
                "id": "base_score_tiers",
                "description": "Existing shared base-importance tier boundaries, not software-kind default scores.",
                "value_type": "object",
                "update_class": "publish_plan",
                "status": "active",
                "value_source": "host_manager_profile",
                "source_path": "/hot_publish/smart_coordinator/base_score_tiers",
                "consumers": ["HostManagerPlanCompiler.CompileSmartCoordinatorHotPublish"]
              }
            ]
          },
          "children": [
            {
              "id": "cpu",
              "description": "Physical-core usage is weighted by the compiled per-core capacity and divided by the shared machine baseline. CPU-input and score smoothing remain separate pending consumers.",
              "build": {
                "complex": [
                  {
                    "index": 0,
                    "id": "smt_accounting",
                    "description": "Compile each physical core's logical sibling count, fixed reciprocal and logical-to-physical mapping from startup topology. Runtime multiplies execution duration by the compiled share; it does not discover topology or count active threads. Separate from CPU-Z weights and B.",
                    "value_type": "object",
                    "update_class": "rebuild_backend",
                    "status": "active",
                    "value_source": "registry",
                    "value": { "kind": "fixed_logical_processor_share" },
                    "consumers": ["HostManagerPlanCompiler.CompileCpuCoreResidency"]
                  }
                ]
              },
              "runtime": {
                "simple": [
                  {
                    "index": 0,
                    "id": "machine_baseline_ratio",
                    "description": "One machine reference B for all software, independent of core performance weights.",
                    "value_type": "number",
                    "update_class": "publish_plan",
                    "status": "active",
                    "value_source": "cpu_configuration",
                    "source_path": "/baseline_ratio",
                    "consumers": ["HostManagerPlanCompiler.CompileCpuScoring"]
                  },
                  {
                    "index": 1,
                    "id": "cpu_input_retained_rounds",
                    "description": "Retained CPU input rounds requested by the CPU algorithm; retention does not prescribe an average.",
                    "value_type": "positive_int32",
                    "update_class": "publish_plan",
                    "status": "pending",
                    "pending_reason": "The user requested three CPU rounds. The CPU history consumer is not yet connected; the stateless welfare-capacity intermediate is not a data item or history consumer."
                  },
                  {
                    "index": 2,
                    "id": "score_retained_rounds",
                    "description": "Independent retained score rounds; five rounds is an example, not an adopted product default.",
                    "value_type": "positive_int32",
                    "update_class": "publish_plan",
                    "status": "pending",
                    "pending_reason": "Score history and its independent algorithm have not been implemented or calibrated."
                  }
                ],
                "complex": [
                  {
                    "index": 0,
                    "id": "state_multipliers",
                    "description": "Current CPU runtime-state multiplier table, consumed in ABI state order.",
                    "value_type": "array",
                    "update_class": "publish_plan",
                    "status": "active",
                    "value_source": "host_manager_profile",
                    "source_path": "/hot_publish/smart_coordinator/process_policy/state_multipliers",
                    "consumers": ["HostManagerPlanCompiler.CompileSmartCoordinatorHotPublish"]
                  },
                  {
                    "index": 1,
                    "id": "core_performance_weights",
                    "description": "Compiled per-physical-core reference weights. Complete manual vectors or known homogeneous relative units are available; unadmitted CPU-Z research and heuristic topology display scores are not automatic weights.",
                    "value_type": "object",
                    "update_class": "publish_plan",
                    "status": "active",
                    "value_source": "cpu_configuration",
                    "source_path": "/core_performance_weights",
                    "consumers": ["HostManagerPlanCompiler.CompileCpuScoring"]
                  },
                  {
                    "index": 2,
                    "id": "cpu_input_algorithm",
                    "description": "Algorithm consuming the requested CPU history, independent of the cache contract.",
                    "value_type": "object",
                    "update_class": "publish_plan",
                    "status": "pending",
                    "pending_reason": "The current scorer uses instantaneous weighted physical-core CPU. CPU input smoothing has not been connected."
                  },
                  {
                    "index": 3,
                    "id": "score_algorithm",
                    "description": "Independent score smoothing after the unique weighted CPU formula.",
                    "value_type": "object",
                    "update_class": "publish_plan",
                    "status": "pending",
                    "pending_reason": "No score-history consumer exists. Do not treat three transition votes as score smoothing."
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "service_recovery",
          "description": "Background service crash recovery.",
          "build": {
            "simple": [
              {
                "index": 0,
                "id": "crash_counter_reset_seconds",
                "description": "Reset the service crash counter after this many seconds without a crash.",
                "value_type": "positive_int32",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": 86400,
                "consumers": ["HostManagerPlanCompiler.CompileServiceRecovery"]
              }
            ]
          }
        },
        {
          "id": "trusted_access",
          "description": "Backend access-request lifetime, used by the bounded local approval flow.",
          "build": {
            "simple": [
              {
                "index": 0,
                "id": "request_lifetime_ms",
                "description": "Lifetime in milliseconds for an unbound local access request and its one-time key delivery.",
                "value_type": "positive_int32",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": 300000,
                "consumers": [
                  "HostManagerPlanCompiler.CompileTrustedAccessRequestLifetime"
                ]
              }
            ]
          }
        },
        {
          "id": "business_blocks",
          "description": "Fixed-capacity backend control for business-block workers, queues, readers, arenas, and failure reasons.",
          "build": {
            "simple": [
              {
                "index": 0,
                "id": "worker_count",
                "description": "Number of workers in the native backend business-block scheduler.",
                "value_type": "positive_int32",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": 4,
                "consumers": ["BackendControlSettings.Compile"]
              },
              {
                "index": 1,
                "id": "history_capacity",
                "description": "Maximum completed business-block results retained for diagnostics.",
                "value_type": "nonnegative_int32",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": 128,
                "consumers": ["BackendControlSettings.Compile"]
              },
              {
                "index": 2,
                "id": "completion_capacity",
                "description": "Maximum completed business-block results awaiting consumption.",
                "value_type": "positive_int32",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": 128,
                "consumers": ["BackendControlSettings.Compile"]
              },
              {
                "index": 3,
                "id": "reader_capacity",
                "description": "Maximum business-block state readers admitted by native control.",
                "value_type": "positive_int32",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": 16,
                "consumers": ["BackendControlSettings.Compile"]
              },
              {
                "index": 4,
                "id": "reader_bytes",
                "description": "Maximum byte size of a retained business-block reader payload.",
                "value_type": "positive_int32",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": 4096,
                "consumers": ["BackendControlSettings.Compile"]
              },
              {
                "index": 5,
                "id": "worker_arena_bytes",
                "description": "Byte capacity of each native business-block worker arena.",
                "value_type": "positive_int32",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": 65536,
                "consumers": ["BackendControlSettings.Compile"]
              },
              {
                "index": 6,
                "id": "reason_text_capacity",
                "description": "Maximum characters retained for a business-block failure reason.",
                "value_type": "positive_int32",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": 256,
                "consumers": ["BackendControlSettings.Compile"]
              }
            ]
          }
        },
        {
          "id": "hardware_bridge",
          "description": "Optional hardware helper availability; checks never start the helper.",
          "build": {
            "simple": [
              {
                "index": 0,
                "id": "availability_check_interval_ms",
                "description": "Check changeable prerequisites only while unavailable. Zero disables polling; installation events still update availability.",
                "value_type": "nonnegative_int32",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": 30000,
                "consumers": ["HostManagerPlanCompiler.CompileHardwareBridgeAvailabilityCheckInterval"]
              }
            ]
          }
        },
        {
          "id": "reports",
          "description": "Backend report coordinator observation storage.",
          "build": {
            "simple": [
              {
                "index": 0,
                "id": "observation_growth_limit",
                "description": "Maximum retained report observations after a native required-count query. Default 16384; accepts the initial profile limit through 536870912. Native persistence capacity and resident-byte budget also apply. One reserve and retry per observation; no eviction.",
                "value_type": "positive_int32",
                "update_class": "rebuild_backend",
                "status": "active",
                "value_source": "registry",
                "value": 16384,
                "consumers": [ "HostManagerPlanCompiler.Compile" ]
              }
            ]
          },
          "children": []
        }
      ]
    }
  ]
}
