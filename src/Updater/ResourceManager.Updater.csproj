<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ResourceManager.Updater.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\ResourceManager.Shared.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="WinUI\**\*.cs" />
    <Compile Include="..\UI\Overlay\LegacyStartupModuleMigration.cs" Link="FrontendPackaging\LegacyStartupModuleMigration.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Resource Manager-APP.Tests" />
    <InternalsVisibleTo Include="Install" />
  </ItemGroup>
</Project>
