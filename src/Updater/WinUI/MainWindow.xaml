<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ResourceManager.UpdateManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Resource Manager">
  <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
  <ScrollViewer>
    <StackPanel Padding="28" Spacing="16" MaxWidth="740" HorizontalAlignment="Stretch">
      <TextBlock x:Name="HeadingText" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock x:Name="IntroText"
                 TextWrapping="Wrap" />
      <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />
      <TextBlock x:Name="InstallStatus" Text="" TextWrapping="Wrap" />
      <TextBlock x:Name="ManagerStatus" Text="" TextWrapping="Wrap" />
      <TextBlock x:Name="RecoveryStatus" Text="" TextWrapping="Wrap" />
      <Button x:Name="RecoverButton" Content="" Click="Recover_Click" IsEnabled="False" />
      <TextBlock x:Name="PackageHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PackagePath" PlaceholderText=""
                 TextChanged="PackagePath_TextChanged" />
        <Button x:Name="BrowseButton" Grid.Column="1" Click="Browse_Click" />
      </Grid>
      <TextBlock x:Name="VersionRulesText"
                 TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="UpdateButton" Content="" Click="Update_Click" IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />
        <Button x:Name="RepairButton" Content="" Click="Repair_Click" IsEnabled="False" />
      </StackPanel>
      <ProgressRing x:Name="Working" IsActive="False" Width="24" Height="24"
                    HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</Window>
