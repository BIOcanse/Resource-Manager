<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ResourceManager.UpdateManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Resource Manager 更新管理">
  <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
  <ScrollViewer>
    <StackPanel Padding="28" Spacing="16" MaxWidth="740" HorizontalAlignment="Stretch">
      <TextBlock Text="更新管理" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock Text="更新、恢复或修复 Resource Manager。操作前会显示将执行的动作。"
                 TextWrapping="Wrap" />
      <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />
      <TextBlock x:Name="InstallStatus" Text="正在读取安装状态…" TextWrapping="Wrap" />
      <TextBlock x:Name="ManagerStatus" Text="" TextWrapping="Wrap" />
      <TextBlock x:Name="RecoveryStatus" Text="" TextWrapping="Wrap" />
      <Button x:Name="RecoverButton" Content="恢复中断的更新" Click="Recover_Click" IsEnabled="False" />
      <TextBlock Text="已解压的完整发行包目录" Style="{StaticResource SubtitleTextBlockStyle}" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PackagePath" PlaceholderText="选择包含 release-manifest.json 的文件夹"
                 TextChanged="PackagePath_TextChanged" />
        <Button Grid.Column="1" Content="浏览…" Click="Browse_Click" />
      </Grid>
      <TextBlock Text="更新只接受更高版本；修复使用与当前版本相同的发行包。两项操作都会保留用户数据和旧目录备份。"
                 TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="UpdateButton" Content="更新主程序" Click="Update_Click" IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />
        <Button x:Name="RepairButton" Content="修复主程序" Click="Repair_Click" IsEnabled="False" />
      </StackPanel>
      <ProgressRing x:Name="Working" IsActive="False" Width="24" Height="24"
                    HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</Window>
