<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ResourceManager.NativeUi</AssemblyName>
    <RootNamespace>ResourceManager.NativeUi</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <CopyOutputSymbolsToPublishDirectory Condition="'$(Configuration)' == 'Release'">false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="FreedomPoint.Core" Version="0.1.0-dev.46" />
  </ItemGroup>
  <Target Name="GenerateStateItems"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)/../../Shared/StateItems/state-items.json;$(MSBuildProjectDirectory)/../../../scripts/build/Generate-StateItems.ps1;$(MSBuildProjectDirectory)/../../../scripts/build/StateItemRegistry.psm1"
          Outputs="$(IntermediateOutputPath)StateItems.g.cs;$(IntermediateOutputPath)DesktopStateItems.g.cs">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../../scripts/build/Generate-StateItems.ps1&quot; -Registry &quot;$(MSBuildProjectDirectory)/../../Shared/StateItems/state-items.json&quot; -Process window -Namespace ResourceManager.NativeUi.StateItems -Output &quot;$(IntermediateOutputPath)StateItems.g.cs&quot;" />
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../../scripts/build/Generate-StateItems.ps1&quot; -Registry &quot;$(MSBuildProjectDirectory)/../../Shared/StateItems/state-items.json&quot; -Process desktop -Namespace ResourceManager.NativeUi.DesktopStateItems -Output &quot;$(IntermediateOutputPath)DesktopStateItems.g.cs&quot;" />
  </Target>
  <Target Name="IncludeStateItems" BeforeTargets="CoreCompile;FreedomPointCompilerInputs" DependsOnTargets="GenerateStateItems" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)StateItems.g.cs" />
      <Compile Include="$(IntermediateOutputPath)DesktopStateItems.g.cs" />
    </ItemGroup>
  </Target>
  <Target Name="GenerateFrontendPreferenceValues" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../../scripts/build/Generate-FrontendPreferences.ps1&quot; -WorkRoot &quot;$(ResourceManagerLedgerWorkRoot)&quot; -GeneratorPath &quot;$(ResourceManagerFrontendGeneratorPath)&quot;" />
    <ItemGroup>
      <Compile Remove="@(Compile)" Condition="'%(Compile.Filename)%(Compile.Extension)' == 'FrontendPoints.Values.g.cs'" />
      <Compile Include="$(MSBuildProjectDirectory)\Preferences\Generated\FrontendPoints.Values.g.cs" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="Overlay\metric-labels.json"
                      LogicalName="ResourceManager.NativeUi.Overlay.metric-labels.json" />
    <ProjectReference Include="..\..\Shared\ResourceManager.Shared.csproj" />
    <None Include="..\..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\..\NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\Core\ThirdPartyNotices\WebView2.*.txt" Link="ThirdPartyNotices\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="WebView\InstallWebView2Runtime.ps1" Link="InstallWebView2Runtime.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\Core\ThirdPartyNotices\DotNet.*.txt;..\..\Core\ThirdPartyNotices\Microsoft.MIT.txt;..\..\Core\ThirdPartyNotices\ManagedDependencyAcknowledgements.md" Link="ThirdPartyNotices\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="RemoveReleasePortableDebugSymbolsFromPublish"
          AfterTargets="ComputeFilesToPublish"
          BeforeTargets="CopyFilesToPublishDirectory"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
