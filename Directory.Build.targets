<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ResourceManager.App' or '$(MSBuildProjectName)' == 'ResourceManager.ReadWriteCore' or '$(MSBuildProjectName)' == 'ResourceManager.Shared'">
    <RuntimeReadStrict Condition="'$(RuntimeReadStrict)' == ''">false</RuntimeReadStrict>
    <!-- Findings remain visible when the project treats its other warnings as errors. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);RMR000</WarningsNotAsErrors>
    <WarningsNotAsErrors Condition="'$(RuntimeReadStrict)' != 'true'">$(WarningsNotAsErrors);RMR001;RMR003;RMR103</WarningsNotAsErrors>
    <WarningsAsErrors Condition="'$(RuntimeReadStrict)' == 'true'">$(WarningsAsErrors);RMR001;RMR003;RMR103</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Changing mode changes the generated analyzer configuration and reruns Csc. -->
    <CompilerVisibleProperty Include="RuntimeReadStrict" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ResourceManager.App' or '$(MSBuildProjectName)' == 'ResourceManager.ReadWriteCore' or '$(MSBuildProjectName)' == 'ResourceManager.Shared'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Development/RuntimeReadCheck/ResourceManager.RuntimeReadCheck.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ResourceManager.App'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/Core/Native/**/*.c;$(MSBuildThisFileDirectory)src/Core/Native/**/*.cpp;$(MSBuildThisFileDirectory)src/Core/Native/**/*.h;$(MSBuildThisFileDirectory)src/Core/Native/**/*.hpp;$(MSBuildThisFileDirectory)src/Core/Native/**/*.inc;$(MSBuildThisFileDirectory)src/Core/NativeCore/**/*.zig;$(MSBuildThisFileDirectory)src/Core/NativeCore/**/*.h"
                     Exclude="$(MSBuildThisFileDirectory)**/bin/**;$(MSBuildThisFileDirectory)**/obj/**;$(MSBuildThisFileDirectory)**/zig-out/**;$(MSBuildThisFileDirectory)**/.zig-cache/**;$(MSBuildThisFileDirectory)**/third_party/**;$(MSBuildThisFileDirectory)**/third-party/**;$(MSBuildThisFileDirectory)**/vendor/**" />
  </ItemGroup>
  <!-- The FreedomPoint source checks read a project's compile inputs without compiling it
       (scripts/validation/Get-FreedomPointCompilerContext.ps1). A target that adds generated Compile items
       before CoreCompile also runs before this one, so the checks see the same files Csc compiles. -->
  <Target Name="FreedomPointCompilerInputs"
          DependsOnTargets="ResolveReferences;GenerateGlobalUsings;GenerateAssemblyInfo;GenerateTargetFrameworkMonikerAttribute" />
  <!-- SDK defaults have been imported here, so this constant reaches Csc. Tests share the switch. -->
  <PropertyGroup Condition="'$(ResourceManagerStateNames)' == 'true' and ('$(MSBuildProjectName)' == 'ResourceManager.App' or '$(MSBuildProjectName)' == 'ResourceManager.NativeUi' or '$(MSBuildProjectName)' == 'Resource Manager-APP.Tests')">
    <DefineConstants>$(DefineConstants);RM_STATE_NAMES</DefineConstants>
  </PropertyGroup>
  <!-- Composite R2R recompiles the framework together with the app, whether it
       publishes single-file or as a folder. Publish each assembly separately
       within the existing bounded build. -->
  <PropertyGroup Condition="'$(PublishReadyToRun)' == 'true'">
    <PublishReadyToRunComposite Condition="'$(PublishReadyToRunComposite)' == ''">false</PublishReadyToRunComposite>
    <PublishReadyToRunCrossgen2ExtraArgs Condition="'$(PublishReadyToRunCrossgen2ExtraArgs)' == ''">--parallelism:1</PublishReadyToRunCrossgen2ExtraArgs>
  </PropertyGroup>
  <!-- TraceEvent 3.2.4 admits these same COM assemblies through both runtime
       assets and None-copy items. Crossgen2 rejects their duplicate R2R inputs.
       Keep runtime assets and ordinary output copies; suppress only the two
       exact redundant package-to-root publish copies in every project. -->
  <Target Name="AvoidDuplicateTraceEventInteropPublishCopies"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(PublishReadyToRun)' == 'true' and '$(NuGetPackageRoot)' != ''">
    <PropertyGroup>
      <_TraceEventDia2Path>$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)\microsoft.diagnostics.tracing.traceevent\3.2.4\lib\netstandard2.0\Dia2Lib.dll'))</_TraceEventDia2Path>
      <_TraceEventReloggerPath>$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)\microsoft.diagnostics.tracing.traceevent\3.2.4\lib\netstandard2.0\TraceReloggerLib.dll'))</_TraceEventReloggerPath>
    </PropertyGroup>
    <ItemGroup>
      <None Update="@(None)"
            Condition="('%(None.FullPath)' == '$(_TraceEventDia2Path)' and '%(None.Link)' == 'Dia2Lib.dll') or ('%(None.FullPath)' == '$(_TraceEventReloggerPath)' and '%(None.Link)' == 'TraceReloggerLib.dll')">
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      </None>
    </ItemGroup>
  </Target>
</Project>
