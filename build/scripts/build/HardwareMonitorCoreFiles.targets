<Project>
  <!-- The embedded desktop fan backend loads the official core library from disk.
       Keep its resolved runtime dependencies beside it in single-file products. -->
  <PropertyGroup>
    <HardwareMonitorCoreSharedPackages>;LibreHardwareMonitorLib;DiskInfoToolkit;HidSharp;RAMSPDToolkit-NDD;BlackSharp.Core;Mono.Posix.NETStandard;System.IO.FileSystem.AccessControl;System.IO.Ports;System.Management;System.CodeDom;</HardwareMonitorCoreSharedPackages>
  </PropertyGroup>
  <Target Name="KeepHardwareMonitorCoreSharedFiles" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.Extension)' == '.dll' and $([System.String]::Copy('$(HardwareMonitorCoreSharedPackages)').Contains(';%(ResolvedFileToPublish.NuGetPackageId);'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
